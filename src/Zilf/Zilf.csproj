<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>zilf</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x86;win-x64;linux-arm;linux-arm64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
    <OutputType>Exe</OutputType>
    <Description>The ZIL Implementation You Really, Really Like.</Description>
    <Deterministic>false</Deterministic>
    <Nullable>enable</Nullable>
	<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PortableTarget)' != 'true'">
	  <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- <PublishSingleFile>true</PublishSingleFile> -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSBuildTasks" Version="1.5.0.235" />
    <PackageReference Include="ReadLine" Version="2.0.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-rc.2.25502.107" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zilf.Emit\Zilf.Emit.csproj" />
    <ProjectReference Include="..\Zilf.Common\Zilf.Common.csproj" />
  </ItemGroup>

  <!-- only use the analyzer if it's been built for this target -->
  <PropertyGroup>
    <ZilfAnalyzersAssembly>..\Analyzers\ZilfAnalyzers\ZilfAnalyzers\bin\$(Configuration)\$(TargetFramework)\ZilfAnalyzers.dll</ZilfAnalyzersAssembly>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <RunAnalyzersDuringBuild>True</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>7</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Condition="Exists('$(ZilfAnalyzersAssembly)')" Include="$(ZilfAnalyzersAssembly)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Analyzers\ZilfSourceGenerators\ZilfSourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false">
      <GlobalPropertiesToRemove>PublishAot;SelfContained;PublishTrimmed</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <!-- Ensure no stray generated file at project root is compiled -->
  <ItemGroup>
    <Compile Remove="BuildInfo.g.cs" />
  </ItemGroup>

  <!-- Generate build timestamp only for publish when explicitly enabled.
       Default disabled to avoid constant project rebuilds during development. -->
  <PropertyGroup>
    <IncludeBuildTimestamp>false</IncludeBuildTimestamp>
    <GeneratedBuildInfo>$(IntermediateOutputPath)BuildInfo.g.cs</GeneratedBuildInfo>
  </PropertyGroup>
  <Target Name="GenerateBuildInfo"
          BeforeTargets="Publish"
          Condition="'$(IncludeBuildTimestamp)' == 'true'">
    <PropertyGroup>
      <!-- Use reproducible UTC time if provided by CI; otherwise current UTC -->
      <_BuildTimeUtc>$([System.DateTime]::UtcNow.ToString('o'))</_BuildTimeUtc>
      <_GeneratedBuildInfoText>namespace Zilf { internal static partial class BuildInfo { static BuildInfo() { BuildTimestampUtc = System.DateTime.Parse("$(_BuildTimeUtc)", null, System.Globalization.DateTimeStyles.RoundtripKind)%3B } } }</_GeneratedBuildInfoText>
    </PropertyGroup>
    <WriteLinesToFile File="$(GeneratedBuildInfo)" Overwrite="true" Lines="$(_GeneratedBuildInfoText)" />
    <ItemGroup>
      <Compile Include="$(GeneratedBuildInfo)" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
</Project>