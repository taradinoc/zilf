<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <Nullable>warnings</Nullable>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>8</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>8</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" Version="3.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.0" />
    <PackageReference Include="Tewr.BlazorWorker.BackgroundService" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zapf\Zapf.csproj" />
    <ProjectReference Include="..\Zilf\Zilf.csproj" />
  </ItemGroup>

  <!--
    Build-time assets wiring for project templates:
    - Copy all folders/files from repo-level /sample/** and /zillib/** into wwwroot/project_templates
    - Register them as Content after copying so they appear in the static asset manifest
  -->
  <ItemGroup>
    <!-- Exclude all files from wwwroot/project_templates to avoid duplicates during initial evaluation -->
    <Content Remove="wwwroot\project_templates\**\*" />
  </ItemGroup>

  <!-- Ensure no stray generated file at project root is compiled -->
  <ItemGroup>
    <Compile Remove="BuildInfo.g.cs" />
  </ItemGroup>

  <!-- Generate a build timestamp source file before compilation -->
  <PropertyGroup>
    <GeneratedBuildInfo>$(IntermediateOutputPath)BuildInfo.g.cs</GeneratedBuildInfo>
  </PropertyGroup>
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <!-- Use reproducible UTC time if provided by CI; otherwise current UTC -->
      <_BuildTimeUtc>$([System.DateTime]::UtcNow.ToString("o"))</_BuildTimeUtc>
      <_GeneratedBuildInfoText>namespace Zilf.Playground { internal static partial class BuildInfo { static BuildInfo() { BuildTimestampUtc = System.DateTime.Parse("$(_BuildTimeUtc)", null, System.Globalization.DateTimeStyles.RoundtripKind)%3B } } }</_GeneratedBuildInfoText>
    </PropertyGroup>
    <WriteLinesToFile File="$(GeneratedBuildInfo)" Overwrite="true" Lines="$(_GeneratedBuildInfoText)" />
    <ItemGroup>
      <!-- Ensure we only include once; keep at project root for IDE visibility -->
      <Compile Include="$(GeneratedBuildInfo)" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Copy samples and zillib into wwwroot, then register as Content for static asset manifest -->
  <Target Name="CopyProjectTemplates" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <SampleFiles Include="..\..\sample\**\*" />
      <ZilibFiles Include="..\..\zillib\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(SampleFiles)" DestinationFolder="wwwroot\project_templates\%(RecursiveDir)" SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(ZilibFiles)" DestinationFolder="wwwroot\project_templates\zillib\%(RecursiveDir)" SkipUnchangedFiles="true" />

    <!-- Now register the copied files as Content so they're included in the static asset manifest -->
    <ItemGroup>
      <Content Include="wwwroot\project_templates\**\*" />
    </ItemGroup>
  </Target>

  <Import Project="GenerateReleaseInfo.targets" />

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

</Project>
