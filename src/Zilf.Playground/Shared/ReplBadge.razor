@inject ReplService Session
@implements IDisposable

<span class="badge rounded-pill bg-white text-dark">@ExchangeCount</span>

@code {
    private int? ExchangeCount
    {
        get
        {
            var count = Session.Exchanges.Count;
            return count == 0 ? null : count;
        }
    }

    protected override void OnInitialized()
    {
        Session.ExchangesChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Session.ExchangesChanged -= StateHasChanged;
    }
}
