@inject BuildService Build
@implements IDisposable

<span class="badge rounded-pill @ColorClass">@Build.Status</span>

@code {
    protected override void OnInitialized()
    {
        Build.StatusChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Build.StatusChanged -= StateHasChanged;
    }

    private string ColorClass => Build.Status switch
    {
        BuildStatus.NotBuilt => "bg-secondary",
        BuildStatus.Compiling or BuildStatus.Assembling => "bg-info",
        BuildStatus.CompilerError or BuildStatus.AssemblerError => "bg-danger",
        BuildStatus.Built => "bg-success",
        _ => "bg-warning",
    };
}
