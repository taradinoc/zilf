@typeparam TResult
@inject IJSRuntime JS

<CascadingValue Value="this" IsFixed="true">
    <div @ref="Div" id="modal-@Guid" class="modal fade" tabindex="-1" aria-labelledby="modalLabel-@Guid" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalLabel-@Guid">@Title</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @Body
                </div>
                <div class="modal-footer">
                    @Footer
                </div>
            </div>
        </div>
    </div>
</CascadingValue>

@code {
    public Guid Guid { get; } = Guid.NewGuid();

    [Parameter]
    public string Title { get; set; } = "Modal title";

    [Parameter]
    public RenderFragment Body { get; set; }

    [Parameter]
    public RenderFragment Footer { get; set; }

    private ElementReference Div { get; set; }

    private TResult ModalResult { get; set; }

    public Task<TResult> ShowAsync()
    {
        ModalResult = default;

        DotNetObjectReference<ModalNotifier> notifierReference = default;

        var tcs = new TaskCompletionSource<TResult>();
        var notifier = new ModalNotifier(() => {
            tcs.TrySetResult(ModalResult);
            notifierReference?.Dispose();
            notifierReference = null;
        });
        notifierReference = DotNetObjectReference.Create(notifier);

        JS.InvokeVoidAsync("ZilfJsInterop.showModalAndNotifyWhenHidden", Div, notifierReference, nameof(ModalNotifier.OnHidden));

        return tcs.Task;
    }

    public void Close(TResult result)
    {
        ModalResult = result;
        JS.InvokeVoidAsync("ZilfJsInterop.hideModal", Div);
    }

    class ModalNotifier
    {
        private readonly Action callback;

        public ModalNotifier(Action callback)
        {
            this.callback = callback;
        }

        [JSInvokable]
        public void OnHidden()
        {
            callback.Invoke();
        }
    }
} 