@page "/project"
@using Zilf.Playground.Services
@inject NavigationManager Nav
@inject WorkspaceService Workspace
@inject ProjectStorageService ProjectStorage

@code {
    protected override async Task OnInitializedAsync()
    {
        // Check if there's a current project loaded
        if (Workspace.Project.Files.Count > 0)
        {
            Nav.NavigateTo(Pages.ProjectEdit.GetLink(Workspace.Project, Workspace.Project.MainFile.Path));
            return;
        }
        
        // Check if there are any saved projects
        var savedProjects = await ProjectStorage.GetProjectListAsync();
        if (savedProjects.Count > 0)
        {
            // User has saved projects, show the management page
            Nav.NavigateTo("/project/manage");
        }
        else
        {
            // No saved projects, create a new one
            Nav.NavigateTo("/project/new");
        }
    }
}
