<li class="nav-item d-flex text-nowrap">
    <a class="nav-link @ActiveCssClass" href="@LinkHref">
        <span class="oi oi-document" aria-hidden="true"></span>
        @File.Path
    </a>
    @if (File.Path == EntryPointPath)
    {
        <a class="d-flex align-items-center text-muted" href="#" aria-label="Entry point">
            <span class="oi oi-check" aria-hidden="true"></span>
        </a>
    }
</li>

@code {
    [Parameter]
    public ProjectFile File { get; set; }

    [Parameter]
    public bool AllowEntryPoint { get; set; } = false;

    [CascadingParameter(Name = "ActivePath")]
    public string ActivePath { get; set; }

    [CascadingParameter(Name = "EntryPointPath")]
    public string EntryPointPath { get; set; }

    [CascadingParameter(Name = "ProjectId")]
    public string ProjectId { get; set; }

    private string ActiveCssClass => File.Path == ActivePath ? "active" : null;

    private string LinkHref => Pages.ProjectEdit.GetLink(ProjectId, File.Path);
}
