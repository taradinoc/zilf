<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="PackageAllRids" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RootDir>$(MSBuildThisFileDirectory)</RootDir>
    <Solution>$(RootDir)Zilf.sln</Solution>
  <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <PackageBaseDir>$(RootDir)Package/$(Configuration)</PackageBaseDir>
    <StageBaseDir>$(PackageBaseDir)/Stage</StageBaseDir>
    <PackagesDir>$(PackageBaseDir)/Packages</PackagesDir>
  </PropertyGroup>

  <UsingTask TaskName="ZipDirectory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll" />

  <Import Project="$(RootDir)CurrentVersion.props" Condition="'$(ReleaseLevel)' == ''" />

  <PropertyGroup>
    <PackageVersion Condition="'$(ReleaseLevel)' == 'final'">$(MajorVersion).$(MinorVersion).$(MicroVersion)</PackageVersion>
    <PackageVersion Condition="'$(ReleaseLevel)' != 'final' or '$(ReleaseSerial)' != '0'">$(MajorVersion).$(MinorVersion).$(MicroVersion)-$(ReleaseLevel)$(ReleaseSerial)</PackageVersion>
    <PackageName Condition="'$(RuntimeIdentifier)' != ''">zilf-$(PackageVersion)-$(RuntimeIdentifier)</PackageName>
  </PropertyGroup>

  <Target Name="RestoreSolution" Condition="'$(AlreadyRestored)' != 'true'">
    <MSBuild Projects="$(Solution)" Targets="Restore" />
  </Target>

  <Target Name="_StageRid" DependsOnTargets="RestoreSolution">
    <Error Condition="'$(RuntimeIdentifier)' == ''" Text="RuntimeIdentifier must be specified when staging." />

    <PropertyGroup>
      <StageDir>$(StageBaseDir)/$(PackageName)</StageDir>
      <StageBinDir>$(StageDir)/bin</StageBinDir>
      <ZilfPublishDir>$(StageDir)/_publish/Zilf/</ZilfPublishDir>
      <ZapfPublishDir>$(StageDir)/_publish/Zapf/</ZapfPublishDir>
    </PropertyGroup>

    <ItemGroup>
      <_RootDocs Include="$(RootDir)README.md;$(RootDir)CHANGELOG.md;$(RootDir)COPYING.txt;$(RootDir)LICENSE.RTL.txt" />
      <_SampleFiles Include="$(RootDir)sample/**/*" Exclude="$(RootDir)sample/**/;$(RootDir)sample/**/bin/**;$(RootDir)sample/**/obj/**;$(RootDir)sample/**/.git/**;$(RootDir)sample/**/.hg/**" />
      <_ZilLibFiles Include="$(RootDir)zillib/**/*" Exclude="$(RootDir)zillib/**/;$(RootDir)zillib/**/bin/**;$(RootDir)zillib/**/obj/**;$(RootDir)zillib/tests/**;$(RootDir)zillib/**/.git/**;$(RootDir)zillib/**/.hg/**;$(RootDir)zillib/**/ZilLib.proj" />
    </ItemGroup>

    <RemoveDir Directories="$(StageDir)" Condition="Exists('$(StageDir)')" />
    <MakeDir Directories="$(StageBinDir)" />

    <MSBuild Projects="$(RootDir)src/Zilf/Zilf.csproj"
         Targets="Publish"
         Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishAot=true;PublishSingleFile=true;PublishTrimmed=true;StripSymbols=true;DebuggerSupport=false;IncludeNativeLibrariesForSelfExtract=true;PublishDir=$(ZilfPublishDir)" />

    <MSBuild Projects="$(RootDir)src/Zapf/Zapf.csproj"
         Targets="Publish"
         Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishAot=true;PublishSingleFile=true;PublishTrimmed=true;StripSymbols=true;DebuggerSupport=false;IncludeNativeLibrariesForSelfExtract=true;PublishDir=$(ZapfPublishDir)" />

    <Copy SourceFiles="@(_RootDocs)" DestinationFolder="$(StageDir)" />

    <MakeDir Directories="$(StageDir)/sample" Condition="!Exists('$(StageDir)/sample')" />
    <MakeDir Directories="$(StageDir)/zillib" Condition="!Exists('$(StageDir)/zillib')" />

    <Copy SourceFiles="@(_SampleFiles)" DestinationFiles="@(_SampleFiles->'$(StageDir)/sample/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(_ZilLibFiles)" DestinationFiles="@(_ZilLibFiles->'$(StageDir)/zillib/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <ItemGroup>
      <!-- Include both upper- and lower-case binary names to support platforms where AssemblyName is lower-case -->
      <_PublishOutputs Include="
          $(ZilfPublishDir)Zilf*;
          $(ZilfPublishDir)zilf*;
          $(ZapfPublishDir)Zapf*;
          $(ZapfPublishDir)zapf*;
          $(ZilfPublishDir)createdump*;
          $(ZapfPublishDir)createdump*"
                        Exclude="
          $(ZilfPublishDir)Zilf.Common*;
          $(ZilfPublishDir)zilf.common*;
          $(ZapfPublishDir)Zilf.Common*;
      $(ZapfPublishDir)zilf.common*;
      $(ZilfPublishDir)*.pdb;
      $(ZilfPublishDir)*.dbg;
      $(ZapfPublishDir)*.pdb;
      $(ZapfPublishDir)*.dbg;
      $(ZilfPublishDir)*.dSYM/**;
      $(ZapfPublishDir)*.dSYM/**;
      $(ZilfPublishDir)*.dSYM;
      $(ZapfPublishDir)*.dSYM" />
    </ItemGroup>

    <Copy SourceFiles="@(_PublishOutputs)" DestinationFiles="@(_PublishOutputs->'$(StageBinDir)/%(Filename)%(Extension)')" />

    <RemoveDir Directories="$(StageDir)/_publish" Condition="Exists('$(StageDir)/_publish')" />
  </Target>

  <Target Name="Stage" DependsOnTargets="_StageRid" />

  <Target Name="Package" DependsOnTargets="Stage">
    <PropertyGroup>
      <ZipOutputFile>$(PackagesDir)/$(PackageName).zip</ZipOutputFile>
    </PropertyGroup>

    <MakeDir Directories="$(PackagesDir)" Condition="!Exists('$(PackagesDir)')" />

    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ZipOutputFile)" Overwrite="true" />
  </Target>

  <Target Name="PackageAllRids">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="RestoreSolution" />

    <ItemGroup>
      <RidToPackage Include="$(RuntimeIdentifiers)" />
      <RidInvocation Include="@(RidToPackage->'$(MSBuildProjectFullPath)')">
        <AdditionalProperties>RuntimeIdentifier=%(RidToPackage.Identity);AlreadyRestored=true;Configuration=$(Configuration)</AdditionalProperties>
      </RidInvocation>
    </ItemGroup>

    <MSBuild Projects="@(RidInvocation)" Targets="Package" />
  </Target>

</Project>
